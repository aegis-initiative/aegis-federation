---
import Header from '../components/Header.astro';
import Footer from '@aegis-initiative/design-system/components/Footer.astro';
import Breadcrumb from '@aegis-initiative/design-system/components/Breadcrumb.astro';
import AegisWordmark from '@aegis-initiative/design-system/components/AegisWordmark.astro';
import TableOfContents from '@aegis-initiative/design-system/components/TableOfContents.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = "Decentralized governance intelligence sharing via the AT Protocol.",
} = Astro.props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const fullTitle = `${title} | AEGIS Federation`;
const isHome = Astro.url.pathname === "/" || Astro.url.pathname === "";

// Auto-generate breadcrumbs from URL path for release pages.
// Federation only has a landing page + release notes — no other sections need
// breadcrumbs.
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const segments = pathname.split('/').filter(Boolean);

const MONTH_NAMES = [
  'January', 'February', 'March', 'April', 'May', 'June',
  'July', 'August', 'September', 'October', 'November', 'December',
];

const breadcrumbItems: { label: string; href?: string }[] = [];

if (segments[0] === 'releases' && segments.length >= 1) {
  if (segments.length === 1) {
    breadcrumbItems.push({ label: 'Releases' });
  } else if (segments.length >= 3) {
    const yy = segments[1];
    const month = segments[2];
    const day = segments[3];
    const year = 2000 + parseInt(yy, 10);
    const monthIdx = parseInt(month, 10) - 1;
    const monthName = MONTH_NAMES[monthIdx] ?? month;

    breadcrumbItems.push({ label: 'Releases', href: '/releases/' });
    if (day !== undefined) {
      breadcrumbItems.push({ label: title });
    } else {
      breadcrumbItems.push({ label: `${monthName} ${year}` });
    }
  }
}
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="auto">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:site_name" content="AEGIS Federation" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={pageUrl} />

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://aegis-federation.com#site",
          "name": "AEGIS Federation",
          "url": "https://aegis-federation.com",
          "publisher": {
            "@type": "Organization",
            "name": "AEGIS Initiative",
            "url": "https://aegis-initiative.com"
          }
        },
        isHome ? {
          "@type": "WebPage",
          "name": fullTitle,
          "url": pageUrl,
          "description": description,
          "isPartOf": { "@id": "https://aegis-federation.com#site" }
        } : {
          "@type": "Article",
          "headline": title,
          "name": fullTitle,
          "url": pageUrl,
          "description": description,
          "isPartOf": { "@id": "https://aegis-federation.com#site" },
          "publisher": {
            "@type": "Organization",
            "name": "AEGIS Initiative",
            "url": "https://aegis-initiative.com"
          }
        }
      ]
    })} />

    <!-- AEGIS Ecosystem Navigation Bar -->
    <script is:inline src="/shared/aegis-nav.js" defer></script>
    <script is:inline>
      document.documentElement.style.setProperty('--aegis-nav-height', '32px');
    </script>

    <!-- FOUC prevention -->
    <script is:inline>
      (function () {
        const stored = localStorage.getItem('aegis-theme');
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = stored || preferred;
      })();
    </script>

    <slot name="head" />
  </head>
  <body>
    <Header />
    {breadcrumbItems.length > 0 && <Breadcrumb items={breadcrumbItems} homeLabel="AEGIS Federation" />}
    <div class="page-wrapper">
      <main class="main-content">
        <slot />
        <Footer />
        <div class="watermark">
          <AegisWordmark height={720} />
        </div>
      </main>
      <TableOfContents />
    </div>
  </body>
</html>

<style is:global>
  @import '@aegis-initiative/design-system/css/fonts.css';
  @import '@aegis-initiative/design-system/css/tokens.css';
  @import '@aegis-initiative/design-system/css/reset.css';

  h1, h2, h3, h4, h5, h6 {
    scroll-margin-top: calc(5rem + var(--aegis-nav-height, 0px));
  }

  [id] {
    scroll-margin-top: calc(6.55rem + var(--aegis-nav-height, 0px));
  }

  html { scroll-behavior: smooth; }

  .toc-list a,
  .toc-dropdown-list a {
    text-decoration: none;
  }

  /* Federation has no fixed sidebar — override the package's default
     320px sidebar offset on the breadcrumb so it aligns with the
     centered main content instead. */
  @media (min-width: 1024px) {
    .breadcrumb {
      padding-left: 1.5rem !important;
      max-width: 72rem;
      margin: 0 auto;
    }
  }

  .page-wrapper {
    display: flex;
    flex: 1;
    width: 100%;
  }

  .main-content {
    flex: 1;
    min-width: 0;
    padding: 2rem 1.5rem;
    max-width: 72rem;
  }

  .watermark {
    display: flex;
    justify-content: center;
    padding: 3rem 0 1rem;
    opacity: 0.08;
    filter: grayscale(100%);
    pointer-events: none;
    user-select: none;
  }

  @media (min-width: 1024px) {
    .main-content {
      padding: 2rem;
    }
  }

  @media (min-width: 1367px) {
    .main-content {
      margin-right: 320px;
    }
  }
</style>
