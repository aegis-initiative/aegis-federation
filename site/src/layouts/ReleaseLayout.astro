---
/**
 * Layout for release notes Markdown pages.
 * Forwards frontmatter to the standard PageLayout so release notes get
 * the same chrome (header, footer, breadcrumbs, ToC) as the landing page.
 */
import PageLayout from "./PageLayout.astro";

interface Props {
  frontmatter: {
    title: string;
    description?: string;
  };
}

const { frontmatter } = Astro.props;
---

<PageLayout title={frontmatter.title} description={frontmatter.description}>
  <slot />
</PageLayout>
