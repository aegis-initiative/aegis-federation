---
import Header from '../components/Header.astro';
import Footer from '@aegis-initiative/design-system/components/Footer.astro';
import AegisLogo from '@aegis-initiative/design-system/components/AegisLogo.astro';
---

<!doctype html>
<html lang="en" dir="ltr" data-theme="auto">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AEGIS Federation — GFN-1 Specification</title>
    <meta name="description" content="The AEGIS Governance Federation Network specification — decentralized governance intelligence sharing for AI systems, built on the AT Protocol." />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="AEGIS Federation — GFN-1 Specification" />
    <meta property="og:description" content="The AEGIS Governance Federation Network specification — decentralized governance intelligence sharing for AI systems, built on the AT Protocol." />
    <meta property="og:url" content="https://aegis-federation.com/" />
    <meta property="og:site_name" content="AEGIS Federation" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="AEGIS Federation — GFN-1 Specification" />
    <meta name="twitter:description" content="The AEGIS Governance Federation Network specification — decentralized governance intelligence sharing for AI systems, built on the AT Protocol." />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href="https://aegis-federation.com/" />

    <!-- AEGIS Ecosystem Navigation Bar -->
    <script is:inline src="https://aegis-initiative.com/shared/aegis-nav.js" defer></script>
    <script is:inline>
      document.documentElement.style.setProperty('--aegis-nav-height', '32px');
    </script>

    <link rel="preload" href="/fonts/ibmplexsans-variablefont_wdthwght-webfont.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/poppins-light-webfont.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      (function () {
        const stored = localStorage.getItem('aegis-theme');
        const preferred = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = stored || preferred;
      })();
    </script>

    <!-- Structured Data -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": "https://aegis-federation.com#site",
          "name": "AEGIS Federation",
          "url": "https://aegis-federation.com",
          "publisher": {
            "@type": "Organization",
            "name": "AEGIS Initiative",
            "url": "https://aegis-initiative.com"
          }
        },
        {
          "@type": "TechArticle",
          "headline": "AEGIS Federation — GFN-1 Specification",
          "name": "AEGIS Federation — GFN-1 Specification",
          "url": "https://aegis-federation.com/",
          "description": "The AEGIS Governance Federation Network specification — decentralized governance intelligence sharing for AI systems, built on the AT Protocol.",
          "isPartOf": { "@id": "https://aegis-federation.com#site" },
          "publisher": {
            "@type": "Organization",
            "name": "AEGIS Initiative",
            "url": "https://aegis-initiative.com"
          }
        }
      ]
    })} />
  </head>
  <body>
    <Header />

    <main class="hero">
      <div class="hero-logo">
        <AegisLogo size={72} />
      </div>
      <h1 class="hero-title">AEGIS Federation</h1>
      <p class="hero-tagline">
        The Governance Federation Network specification — decentralized governance intelligence sharing for AI systems, built on the <a href="https://atproto.com">AT Protocol</a>.
      </p>

      <div class="status-badges">
        <span class="badge badge-stable">GFN-1 v1.0 — Normative</span>
        <span class="badge">CC BY-SA 4.0</span>
        <span class="badge"><a href="https://github.com/aegis-initiative/aegis-federation">github.com/aegis-initiative/aegis-federation</a></span>
      </div>

      <nav class="nav-grid">
        <a href="/overview/" class="nav-card">
          <h2>Overview</h2>
          <p>Charter, design principles, glossary. Start here if you're new.</p>
        </a>
        <a href="/spec/" class="nav-card">
          <h2>Specification</h2>
          <p>The normative GFN-1 spec — network, schemas, trust model, conformance.</p>
        </a>
        <a href="/rfc/" class="nav-card">
          <h2>RFCs</h2>
          <p>Versioned proposals that extend or amend the specification.</p>
        </a>
        <a href="/roadmap/" class="nav-card">
          <h2>Roadmap</h2>
          <p>Planned RFCs — AI-operational signals, A2A, MCP integration.</p>
        </a>
      </nav>

      <section class="summary">
        <h2>What is the GFN?</h2>
        <p>
          A decentralized network for sharing AI governance intelligence — circumvention reports, risk telemetry, policy updates, attestations, incident notices — across independent operators, with no central authority and no membership gate.
        </p>
        <p>
          The specification defines a vocabulary and a trust model. The wire transport is <a href="https://atproto.com">AT Protocol</a>. The reference network is operated by AEGIS Initiative; the specification is open and may be implemented by anyone.
        </p>
        <p class="summary-cta">
          <a href="/overview/">Read the introduction →</a>
        </p>
      </section>
    </main>

    <Footer />

    <style>
      @font-face {
        font-family: "IBM Plex Sans";
        src: url("/fonts/ibmplexsans-variablefont_wdthwght-webfont.woff2") format("woff2");
        font-weight: 100 700;
        font-style: normal;
        font-display: swap;
      }
      @font-face {
        font-family: "Poppins";
        src: url("/fonts/poppins-light-webfont.woff2") format("woff2");
        font-weight: 300;
        font-style: normal;
        font-display: swap;
      }

      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --color-bg: #ffffff;
        --color-text: #161616;
        --color-text-secondary: #595959;
        --color-text-muted: #707070;
        --color-accent: #0062a5;
        --color-accent-high: #005ea2;
        --color-border: #d4d4d4;
        --color-bg-subtle: #f5f5f5;
        --color-brand-gray: #777777;
        --header-bg: #fafafa;
        --header-border: #777777;
        --header-text: #707070;
        --header-text-muted: #707070;
      }

      [data-theme="dark"] {
        --color-bg: #161616;
        --color-text: #e8e8e8;
        --color-text-secondary: #b0b0b0;
        --color-text-muted: #888888;
        --color-accent: #4da6f0;
        --color-accent-high: #66b2f3;
        --color-border: #3a3a3a;
        --color-bg-subtle: #1e1e1e;
        --color-brand-gray: #999999;
        --header-bg: #000000;
        --header-border: #000000;
        --header-text: #e8e8e8;
        --header-text-muted: #999999;
      }

      body {
        font-family: "Poppins", system-ui, sans-serif;
        font-weight: 300;
        background-color: var(--color-bg);
        color: var(--color-text);
        line-height: 1.7;
        -webkit-font-smoothing: antialiased;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
      }

      a { color: var(--color-accent); }
      a:hover { color: var(--color-accent-high); }

      h1, h2, h3 {
        font-family: "IBM Plex Sans", system-ui, sans-serif;
        font-weight: 400;
        line-height: 1.3;
      }

      .hero {
        flex: 1;
        max-width: 56rem;
        margin: 0 auto;
        padding: 4rem 1.5rem 2rem;
        text-align: center;
      }

      .hero-logo {
        margin-bottom: 1.5rem;
        display: flex;
        justify-content: center;
      }

      .hero-title {
        font-size: clamp(2.5rem, 6vw, 3.5rem);
        margin-bottom: 1rem;
      }

      .hero-tagline {
        font-size: 1.125rem;
        color: var(--color-text-secondary);
        max-width: 44rem;
        margin: 0 auto 2rem;
        line-height: 1.6;
      }

      .status-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        justify-content: center;
        margin-bottom: 2.5rem;
      }

      .badge {
        font-family: "IBM Plex Mono", "Menlo", monospace;
        font-size: 0.8125rem;
        padding: 0.25rem 0.625rem;
        border: 1px solid var(--color-border);
        border-radius: 0.25rem;
        color: var(--color-text-secondary);
        background-color: var(--color-bg-subtle);
      }

      .badge a {
        color: inherit;
        text-decoration: none;
      }

      .badge-stable {
        border-color: var(--color-accent);
        color: var(--color-accent);
        background-color: transparent;
      }

      .nav-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
        gap: 1rem;
        margin-bottom: 3rem;
        text-align: left;
      }

      .nav-card {
        display: block;
        padding: 1.25rem 1.5rem;
        border: 1px solid var(--color-border);
        border-radius: 0.5rem;
        text-decoration: none;
        color: var(--color-text);
        transition: border-color 0.15s, color 0.15s;
      }

      .nav-card:hover {
        border-color: var(--color-accent);
        color: var(--color-accent);
      }

      .nav-card h2 {
        font-weight: 500;
        font-size: 1.1rem;
        margin-bottom: 0.25rem;
      }

      .nav-card p {
        font-size: 0.9rem;
        color: var(--color-text-secondary);
        line-height: 1.4;
      }

      .summary {
        text-align: left;
        max-width: 44rem;
        margin: 0 auto 2rem;
        padding-top: 2rem;
        border-top: 1px solid var(--color-border);
      }

      .summary h2 {
        font-size: 1.5rem;
        margin-bottom: 1rem;
      }

      .summary p {
        margin-bottom: 1rem;
        color: var(--color-text-secondary);
      }

      .summary-cta {
        margin-top: 1.5rem !important;
        font-weight: 500;
      }

      .summary-cta a {
        text-decoration: none;
      }

      @media (max-width: 640px) {
        .nav-grid { grid-template-columns: 1fr; }
        .hero { padding: 3rem 1rem 1.5rem; }
      }
    </style>
  </body>
</html>
